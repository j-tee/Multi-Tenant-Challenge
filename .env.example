# Application Settings
APP_NAME=Invoice Reconciliation API
DEBUG=false

# Database
# SQLite (default for development)
DATABASE_URL=sqlite:///./reconciliation.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/reconciliation

# AI Settings
# Set your OpenAI API key to enable AI-powered explanations
# If not set, the system will use deterministic fallback explanations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=10
AI_ENABLED=true
USE_MOCK_AI=true  # Use mock AI client for testing (set to false to use real OpenAI)

# Reconciliation Settings
RECONCILIATION_DATE_TOLERANCE_DAYS=3
RECONCILIATION_AMOUNT_TOLERANCE_PERCENT=0.01
RECONCILIATION_MIN_TEXT_SIMILARITY=0.3
